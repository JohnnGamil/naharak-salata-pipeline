# ---- AI (free tiers) ----
GEMINI_API_KEY=
# tried in order; free-tier model names change - edit if Google renames them
GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-flash-latest
# optional free key from https://enter.pollinations.ai (anonymous works but ~1 image/hour)
POLLINATIONS_KEY=
# Cloudflare Workers AI (free): dash.cloudflare.com -> profile/api-tokens -> "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# AI Horde (free, no sign-up needed; a free key from aihorde.net/register gives a faster queue)
HORDE_API_KEY=0000000000

# ---- Kaggle GPU ----
KAGGLE_USERNAME=
KAGGLE_KEY=
# new-style token from kaggle.com/settings/api (use this OR KAGGLE_KEY)
KAGGLE_API_TOKEN=
# "<username>/tiktok-clipgen-weights" after running scripts/kaggle_setup.py --weights
KAGGLE_WEIGHTS_KERNEL=

# ---- TikTok ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# unaudited apps can only post SELF_ONLY; switch to PUBLIC_TO_EVERYONE after the audit
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- where videos go (each one only once it is connected) ---
PLATFORMS=tiktok,youtube,instagram
# YouTube Shorts: Google Cloud project -> enable "YouTube Data API v3" -> OAuth client type "Desktop app";
# consent screen "In production" (in "Testing" the login dies after 7 days). Then: python -m scripts.youtube_oauth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# private until Google's API audit passes (unverified projects are forced to private)
YOUTUBE_PRIVACY=private
YOUTUBE_MADE_FOR_KIDS=false
# Instagram Reels: Meta app with "Instagram API with Instagram Login", Professional IG account as tester.
# Then: python -m scripts.instagram_oauth
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# Cloudflare R2 bucket with public access (Instagram downloads the video from a link)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- schedule (Cairo time) ----
POSTS_PER_DAY=2
POST_WINDOWS=13:00-15:00,20:00-23:00
TIMEZONE=Africa/Cairo
BUFFER_SIZE=2

# ---- quality ----
MAX_RETRIES=3
QA_VISUAL_MIN_SCORE=7
QA_AUDIO_MIN_SIMILARITY=0.75
# true = never post when Gemini vision can't check the frames
QA_REQUIRE_VISUAL=false
KAGGLE_WEEKLY_GPU_HOURS_BUDGET=28
# kaggle | fallback
VIDEO_ENGINE=kaggle
